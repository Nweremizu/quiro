{
  "name": "@quiro/desktop",
  "private": true,
  "version": "1.2.2-rc.1",
  "description": "Quiro — screen recorder and editor",
  "author": "Nweremizu",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:app": "tsc --noEmit && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:feature": "npm run build:app && playwright test --config playwright.config.ts",
    "test:ci": "npm run typecheck && npm run test:unit",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "postinstall": "node scripts/postinstall.mjs",
    "copy:wasm": "node scripts/copy-wasm-assets.mjs",
    "rebuild:native": "electron-rebuild --force --only uiohook-napi",
    "build:native-helpers": "node scripts/build-native-helpers.mjs",
    "build:whisper-runtime": "node scripts/build-whisper-runtime.mjs",
    "build:platform-native-helpers": "npm run build:native-helpers && npm run build:windows-capture && npm run build:windows-gpu-export && npm run build:nvidia-cuda-compositor && npm run build:cursor-monitor && npm run build:hud-topmost-guard && npm run build:whisper-runtime",
    "build:windows-gpu-export": "node scripts/build-windows-gpu-export.mjs",
    "build:nvidia-cuda-compositor": "node scripts/build-nvidia-cuda-compositor.mjs",
    "build:windows-capture": "node scripts/build-windows-capture.mjs",
    "build:cursor-monitor": "node scripts/build-cursor-monitor.mjs",
    "build:hud-topmost-guard": "node scripts/build-hud-topmost-guard.mjs",
    "generate:icons": "tsx scripts/generate-icon.ts",
    "rename:exporter-files": "node scripts/rename-exporter-filenames.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^1.21.0",
    "nanoid": "^3.3.15",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.7.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "uiohook-napi": "^1.5.5",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@fix-webm-duration/fix": "^1.0.1",
    "@pixi/filter-drop-shadow": "^5.2.0",
    "@pixi/filter-motion-blur": "^5.1.1",
    "@playwright/test": "^1.60.0",
    "@types/gif.js": "^0.2.5",
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@uiw/color-convert": "^2.10.1",
    "@uiw/react-color-block": "^2.10.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "dnd-timeline": "^3.1.0",
    "electron": "42.2.0",
    "electron-builder": "^26.8.1",
    "emoji-picker-react": "^4.19.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fix-webm-duration": "^1.0.6",
    "gif.js": "^0.2.0",
    "gsap": "^3.15.0",
    "mediabunny": "^1.44.2",
    "motion": "^12.40.0",
    "mp4box": "^2.3.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.18.1",
    "react-resizable-panels": "^4.11.0",
    "react-rnd": "^10.5.3",
    "terser": "^5.47.1",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "uuid": "^14.0.0",
    "vite": "^8.0.14",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.5",
    "web-demuxer": "^4.0.0"
  },
  "main": "dist-electron/main.mjs"
}
