{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Quiro",
	"version": "0.1.0",
	"identifier": "com.bronx.quiro",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build:app",
		"frontendDist": "../dist"
	},
	"app": {
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$APPDATA/**",
					"$HOME/**",
					"$RESOURCE/**",
					"**/*.png",
					"**/*.jpg",
					"**/*.jpeg",
					"**/*.webp",
					"**/*.avif",
					"**/*.mp4"
				]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"nsis",
			"app",
			"dmg",
			"appimage",
			"deb"
		],
		"createUpdaterArtifacts": true,
		"publisher": "Bronx",
		"category": "Productivity",
		"shortDescription": "Beautiful screen recordings, owned by you.",
		"longDescription": "Quiro records your screen and camera and turns the result into a polished, shareable video — locally, with no account required.",
		"icon": [
			"icons/32x32.png",
			"icons/64x64.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"assets/backgrounds": "assets/backgrounds",
			"../../../CHANGELOG.md": "CHANGELOG.md"
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser"
			}
		},
		"macOS": {
			"minimumSystemVersion": "12.0"
		},
		"linux": {
			"deb": {
				"depends": [
					"libwebkit2gtk-4.1-0",
					"libgtk-3-0"
				]
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCQTgyNDhGRDkwODY1NwpSV1JYaHBEOVNJSzZEeVpwWEhpM0M1VCt3Q3ZBSFFuclkwRk0rS0ZyUjlQNHA3M1ljNzdJZmppZAo=",
			"endpoints": [
				"https://REPLACE_WITH_RELEASE_HOST/stable/latest.json"
			]
		}
	}
}
