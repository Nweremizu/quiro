  /* ── Soft Shadows: Light Mode ── */
  --shadow-soft-xs:
    0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 4px rgba(0, 0, 0, 0.03);
  --shadow-soft-sm:
    0 2px 6px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.04);
  --shadow-soft-md:
    0 4px 12px rgba(0, 0, 0, 0.06), 0 2px 6px rgba(0, 0, 0, 0.04);
  --shadow-soft-lg:
    0 8px 24px rgba(0, 0, 0, 0.07), 0 4px 10px rgba(0, 0, 0, 0.04);
  --shadow-soft-xl:
    0 16px 40px rgba(0, 0, 0, 0.08), 0 6px 16px rgba(0, 0, 0, 0.05);
  --shadow-soft-2xl:
    0 24px 64px rgba(0, 0, 0, 0.09), 0 10px 24px rgba(0, 0, 0, 0.05);

  /* Inset */
  --shadow-soft-inset-sm: inset 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-soft-inset-md: inset 0 2px 6px rgba(0, 0, 0, 0.07);

  /* Colored */
  --shadow-soft-primary:
    0 8px 24px rgba(99, 102, 241, 0.12), 0 2px 8px rgba(99, 102, 241, 0.08);
  --shadow-soft-success:
    0 8px 24px rgba(34, 197, 94, 0.12), 0 2px 8px rgba(34, 197, 94, 0.08);
  --shadow-soft-danger:
    0 8px 24px rgba(239, 68, 68, 0.12), 0 2px 8px rgba(239, 68, 68, 0.08);
}

.dark {
  --background: oklch(0.20019308840256111 0 none);
  --foreground: oklch(0.985 0 0);
  --card: oklch(0.205 0 0);
  --card-foreground: oklch(0.985 0 0);
  --popover: oklch(0.205 0 0);
  --popover-foreground: oklch(0.985 0 0);
  --primary: ;
  --primary-foreground: oklch(0.205 0 0);
  --secondary: oklch(0.269 0 0);
  --secondary-foreground: oklch(0.985 0 0);
  --muted: oklch(0.269 0 0);
  --muted-foreground: oklch(0.708 0 0);
  --accent: oklch(0.269 0 0);
  --accent-foreground: oklch(0.985 0 0);
  --destructive: oklch(0.704 0.191 22.216);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.556 0 0);
  --chart-1: oklch(0.87 0 0);
  --chart-2: oklch(0.556 0 0);
  --chart-3: oklch(0.439 0 0);
  --chart-4: oklch(0.371 0 0);
  --chart-5: oklch(0.269 0 0);
  --sidebar: oklch(0.205 0 0);
  --sidebar-foreground: oklch(0.985 0 0);
  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.269 0 0);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.556 0 0);

  --shadow-soft-xs: 0 1px 2px rgba(0, 0, 0, 0.3), 0 1px 3px rgba(0, 0, 0, 0.25);

  --shadow-soft-sm:
    0 2px 6px rgba(0, 0, 0, 0.35), 0 1px 3px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);

  --shadow-soft-md:
    0 4px 12px rgba(0, 0, 0, 0.4), 0 2px 6px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);

  --shadow-soft-lg:
    0 8px 24px rgba(0, 0, 0, 0.45), 0 4px 10px rgba(0, 0, 0, 0.32),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  --shadow-soft-xl:
    0 16px 40px rgba(0, 0, 0, 0.5), 0 6px 16px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  --shadow-soft-2xl:
    0 24px 64px rgba(0, 0, 0, 0.55), 0 10px 24px rgba(0, 0, 0, 0.38),
    inset 0 1px 0 rgba(255, 255, 255, 0.07);

  --shadow-soft-inset-sm: inset 0 1px 3px rgba(0, 0, 0, 0.4);
  --shadow-soft-inset-md: inset 0 2px 6px rgba(0, 0, 0, 0.5);

  --shadow-soft-primary:
    0 8px 24px rgba(99, 102, 241, 0.22), 0 2px 8px rgba(99, 102, 241, 0.16);
  --shadow-soft-success:
    0 8px 24px rgba(34, 197, 94, 0.2), 0 2px 8px rgba(34, 197, 94, 0.14);
  --shadow-soft-danger:
    0 8px 24px rgba(239, 68, 68, 0.22), 0 2px 8px rgba(239, 68, 68, 0.16);

  --blue-ribbon-50: oklch(
    0.9572508149150103 0.020359500447029034 276.95843393216893
  );
