# Copy to .env and fill in. .env is gitignored. Contributors only need this for
# release-style local builds (`pnpm tauri:build`); `pnpm tauri:build:debug`
# works without any of it.

# --- Tauri updater signing (run `pnpm setup:signing` to generate) -----------
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# --- Cloudflare R2 release host (see docs/RELEASE_INFRA.md) -----------------
# Public URL the updater points at. No trailing slash. e.g. https://downloads.quiro.app
RELEASE_BASE_URL=
# R2 bucket name, and the S3 API credentials from an R2 API token.
R2_BUCKET=
CLOUDFLARE_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
