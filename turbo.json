{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env"],
	"globalEnv": ["*"],
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", "!src-tauri/**"],
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "out/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"lint": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
